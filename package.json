{
  "name": "cordova-plugin-tapjack-protection",
  "version": "0.1.0",
  "description": "Tapjacking and screen overlay protection for Cordova apps on Android 9-17 (API 28-37).",
  "license": "MIT",
  "types": "types/index.d.ts",
  "cordova": {
    "id": "cordova-plugin-tapjack-protection",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "keywords": [
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "security",
    "tapjacking",
    "overlay"
  ],
  "engines": {
    "cordovaDependencies": {
      "0.1.0": {
        "cordova": ">=12.0.0",
        "cordova-android": ">=12.0.0"
      }
    }
  },
  "files": [
    "plugin.xml",
    "www/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:js && npm run test:native",
    "test:js": "jest",
    "test:native": "node scripts/native.mjs test",
    "check:native": "node scripts/native.mjs compile"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests/js"
    ]
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
